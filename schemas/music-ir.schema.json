{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://composer-rostrum.dev/schemas/music-ir.schema.json",
  "title": "Composer Rostrum Music IR",
  "type": "object",
  "required": ["tempo", "meter", "tracks"],
  "$defs": {
    "midiNote": {
      "type": "object",
      "required": ["id", "pitch", "start", "duration", "velocity"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "pitch": {"type": "integer", "minimum": 0, "maximum": 127},
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "velocity": {"type": "integer", "minimum": 0, "maximum": 127}
      },
      "additionalProperties": true
    },
    "clip": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["midi", "audio"]},
        "start": {"type": "number", "minimum": 0},
        "length": {"type": "number", "exclusiveMinimum": 0},
        "notes": {"type": "array", "items": {"$ref": "#/$defs/midiNote"}},
        "asset_id": {"type": "string"},
        "source_start": {"type": "number", "minimum": 0},
        "source_end": {"type": "number", "minimum": 0},
        "pitch_semitones": {"type": "number"},
        "stretch_ratio": {"type": "number", "exclusiveMinimum": 0},
        "reversed": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "track": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "kind": {"type": "string"},
        "muted": {"type": "boolean"},
        "gain_db": {"type": "number"},
        "clips": {"type": "array", "items": {"$ref": "#/$defs/clip"}},
        "instruments": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "tempo": {"type": "number", "exclusiveMinimum": 0},
    "meter": {"type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"},
    "key": {"type": ["string", "null"]},
    "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["audio", "midi", "render", "other"]},
          "name": {"type": "string"},
          "duration_seconds": {"type": "number", "minimum": 0},
          "content_hash": {"type": "string"},
          "provenance": {
            "type": "object",
            "properties": {
              "source": {"type": "string"},
              "provider": {"type": "string"},
              "source_uri": {"type": "string"},
              "license": {"type": "string"},
              "attribution": {"type": "string"},
              "rights_verified": {"type": "boolean"},
              "acquired_at": {"type": "string"},
              "derived_from": {"type": "array", "items": {"type": "string"}},
              "operations": {"type": "array", "items": {"type": "object"}}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
